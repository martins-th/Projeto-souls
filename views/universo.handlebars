<section class="universo_inicial">
    <h1 class="universo_titulo_inicial">Tudo aquilo que existe pertence a um ciclo de morte e renascimento.</h1>
</section>

<div class="universo_container">
    <div class="container_historias">
        {{#each historias}}
            {{#each this}}
                <h2 class="historias_titulo" id="{{this.id}}">{{this.titulo}}</h2>
                <p class="historias_texto">{{this.historia}}</p>
            {{/each}}
        {{/each}}
    </div>

    <div class="universo_container_links">
        <ul class="links_lista">
            <li class="container_links_capitulos">capitulos:</li>
            {{#each historias}}
                {{#each this}}
                    <li class="lista_item"><a class="u_item_link" href="#{{this.id}}">{{this.titulo}}</a></li>
                {{/each}}
            {{/each}}
        </ul>
    </div>
</div>