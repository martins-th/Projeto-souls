<div class="individual_inteiro">
    <div class="individual_esquerda">
        <div class="dados_personagem">
            <img src="{{personagens.Foto}}" alt="{{personagens.nome}}" class="dados_imagem">
            <h3 class="dados_nome">{{personagens.nome}}</h3>
            <!-- pretendo colocar um bloco com status dos personagens futuramente -->
        </div>
    </div>
    <div class="individual_direita">
        <div class="historia_personagem">
            <p class="texto">{{personagens.lores}}</p>
        </div>
    </div>
</div>